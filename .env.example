# Plantilla de variables de entorno del proyecto TA3.
# Copiar este archivo como .env y reemplazar los valores "cambiar_..." por claves propias.
# El archivo .env NO se sube a git.

# Zona horaria de los contenedores (los datos MQTT siempre van en UTC)
TZ=America/Lima

# EMQX (broker MQTT)
EMQX_DASHBOARD_USER=admin
# EMQX no lee esta clave: se usa como referencia al cambiar la clave de fábrica
# ("public") en el panel web http://localhost:18083 la primera vez.
EMQX_DASHBOARD_PASSWORD=cambiar_clave_emqx

# InfluxDB 2
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=cambiar_clave_influxdb
INFLUXDB_ORG=fabrica
INFLUXDB_BUCKET=planta
INFLUXDB_RETENTION=30d
INFLUXDB_ADMIN_TOKEN=cambiar_token_largo_aleatorio

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar_clave_grafana

# Simulador (se ejecuta en la laptop, fuera de Docker)
MQTT_HOST=localhost
MQTT_PORT=1883

    {
      "id": 5,
      "type": "stat",
      "title": "Tendencia: pendiente de temperatura",
      "description": "Velocidad de cambio de la temperatura de carcasa en los últimos 5 min (regresión lineal), en °C por minuto. Indicativo: naranja > 1 °C/min, rojo > 2 °C/min (supuestos).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-planta"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 5,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-planta"
          },
          "query": "from(bucket: \"planta\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"temperatura_motor\" and r._field == \"temperature_c\" and r.machine_id == \"motor-01\")\n  |> map(fn: (r) => ({r with x: float(v: int(v: r._time) - int(v: now())) / 60000000000.0}))\n  |> reduce(identity: {n: 0.0, sx: 0.0, sy: 0.0, sxy: 0.0, sxx: 0.0},\n            fn: (r, accumulator) => ({\n              n: accumulator.n + 1.0,\n              sx: accumulator.sx + r.x,\n              sy: accumulator.sy + r._value,\n              sxy: accumulator.sxy + r.x * r._value,\n              sxx: accumulator.sxx + r.x * r.x}))\n  |> filter(fn: (r) => r.n >= 3.0)\n  |> map(fn: (r) => ({_time: now(), _field: \"Pendiente\",\n                      _value: (r.n * r.sxy - r.sx * r.sy) / (r.n * r.sxx - r.sx * r.sx)}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: °C/min",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "displayName": "Pendiente"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      }
